<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.Master.cs" Inherits="GrowWealth.Master.Admin" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Grow Wealth — Admin</title>

    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="<%= ResolveUrl("~/Assets/css/style.css") %>" />

    <style>
        :root {
            --gw-ink: #1a1a1a;
            --gw-ink-soft: #2c2c2c;
            --gw-ink-muted: #6b6b6b;
            --gw-paper: #faf8f3;
            --gw-paper-warm: #f3eee4;
            --gw-surface: #ffffff;
            --gw-line: #e5e0d6;
            --gw-line-soft: #ede9e0;

            --gw-accent: #0b6b3a;
            --gw-accent-dark: #094f2b;
            --gw-accent-soft: #e3efe8;
            --gw-gold: #b88a3e;
            --gw-gold-soft: #f5ead6;
            --gw-rose: #9c3a3a;
            --gw-rose-soft: #f5e0dc;

            --gw-serif: 'Fraunces', Georgia, serif;
            --gw-sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        }

        * { box-sizing: border-box; }

        html, body {
            margin: 0; padding: 0;
            background-color: var(--gw-paper);
            color: var(--gw-ink);
            font-family: var(--gw-sans);
            font-size: 15px;
            line-height: 1.6;
            -webkit-font-smoothing: antialiased;
        }

        a { color: var(--gw-ink); text-decoration: none; transition: color 0.18s; }
        a:hover { color: var(--gw-accent); }

        h1, h2, h3, h4 {
            font-family: var(--gw-serif);
            font-weight: 600;
            color: var(--gw-ink);
            line-height: 1.2;
            letter-spacing: -0.01em;
            margin: 0;
        }

        .admin-topbar {
            background-color: var(--gw-ink);
            color: var(--gw-paper);
            padding: 0.85rem 0;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .admin-topbar-inner {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
        }

        .admin-brand {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .admin-brand .brand-mark {
            width: 28px;
            height: 28px;
            background-color: var(--gw-paper);
            color: var(--gw-ink);
            border-radius: 6px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-family: var(--gw-serif);
            font-weight: 700;
            font-size: 1rem;
        }

        .admin-brand .brand-name {
            font-family: var(--gw-serif);
            font-size: 1.18rem;
            font-weight: 600;
            color: var(--gw-paper);
            letter-spacing: -0.01em;
        }

        .admin-badge {
            background-color: var(--gw-gold);
            color: var(--gw-ink);
            padding: 0.18rem 0.65rem;
            border-radius: 4px;
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            font-weight: 700;
        }

        .admin-user-chip {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .admin-user-chip .user-name {
            color: rgba(250, 248, 243, 0.85);
            font-size: 0.9rem;
        }

        .admin-user-chip .logout-btn {
            background-color: transparent;
            color: var(--gw-paper);
            border: 1px solid rgba(250, 248, 243, 0.3);
            padding: 0.45rem 0.95rem;
            border-radius: 6px;
            font-family: var(--gw-sans);
            font-size: 0.82rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.18s;
            text-decoration: none;
        }

        .admin-user-chip .logout-btn:hover {
            border-color: var(--gw-paper);
            background-color: rgba(250, 248, 243, 0.08);
            color: var(--gw-paper);
        }

        .admin-shell {
            max-width: 1400px;
            margin: 0 auto;
            padding: 1.75rem 2rem;
            display: grid;
            grid-template-columns: 230px 1fr;
            gap: 1.75rem;
        }

        .admin-sidebar {
            position: sticky;
            top: 75px;
            height: fit-content;
        }

        .admin-sidebar-section { margin-bottom: 1.75rem; }

        .admin-sidebar-label {
            font-size: 0.72rem;
            color: var(--gw-ink-muted);
            text-transform: uppercase;
            letter-spacing: 0.12em;
            font-weight: 600;
            padding: 0 0.85rem;
            margin-bottom: 0.5rem;
        }

        .admin-sidebar-link {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.65rem 0.85rem;
            border-radius: 6px;
            color: var(--gw-ink-soft);
            font-size: 0.92rem;
            font-weight: 500;
            transition: all 0.15s;
        }

        .admin-sidebar-link:hover {
            background-color: var(--gw-paper-warm);
            color: var(--gw-ink);
        }

        .admin-sidebar-link.active {
            background-color: var(--gw-ink);
            color: var(--gw-paper);
        }

        .admin-sidebar-link.active:hover {
            background-color: var(--gw-ink);
            color: var(--gw-paper);
        }

        .admin-main {
            min-width: 0;
        }

        @media (max-width: 980px) {
            .admin-shell { grid-template-columns: 1fr; padding: 1.25rem 1.5rem; }
            .admin-sidebar { position: static; }
        }
    </style>

    <asp:ContentPlaceHolder ID="HeadContent" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">

        <header class="admin-topbar">
            <div class="admin-topbar-inner">
                <div class="admin-brand">
                    <span class="brand-mark">G</span>
                    <span class="brand-name">Grow Wealth</span>
                    <span class="admin-badge">Admin</span>
                </div>
                <div class="admin-user-chip">
                    <span class="user-name"><asp:Literal ID="litUserName" runat="server"></asp:Literal></span>
                    <asp:LinkButton ID="btnLogout" runat="server" CssClass="logout-btn"
                        OnClick="btnLogout_Click" CausesValidation="false">Log out</asp:LinkButton>
                </div>
            </div>
        </header>

        <div class="admin-shell">

            <aside class="admin-sidebar">
                <div class="admin-sidebar-section">
                    <div class="admin-sidebar-label">Admin</div>
                    <asp:HyperLink ID="lnkDashboard" runat="server" CssClass="admin-sidebar-link"
                        NavigateUrl="~/Pages/Admin/AdminDashboard.aspx">Overview</asp:HyperLink>
                    <asp:HyperLink ID="lnkCourses" runat="server" CssClass="admin-sidebar-link"
                        NavigateUrl="~/Pages/Admin/ManageCourse.aspx">Courses</asp:HyperLink>
                    <asp:HyperLink ID="lnkUsers" runat="server" CssClass="admin-sidebar-link"
                        NavigateUrl="~/Pages/Admin/ManageUser.aspx">Users</asp:HyperLink>
                    <asp:HyperLink ID="lnkQuizzes" runat="server" CssClass="admin-sidebar-link"
                        NavigateUrl="~/Pages/Admin/ManageQuiz.aspx">Quizzes</asp:HyperLink>
                </div>

                <div class="admin-sidebar-section">
                    <div class="admin-sidebar-label">Member area</div>
                    <asp:HyperLink ID="lnkBackToMember" runat="server" CssClass="admin-sidebar-link"
                        NavigateUrl="~/Pages/Member/Dashboard.aspx">&larr; Back to dashboard</asp:HyperLink>
                </div>
            </aside>

            <main class="admin-main">
                <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
            </main>

        </div>
    </form>
</body>
</html>
