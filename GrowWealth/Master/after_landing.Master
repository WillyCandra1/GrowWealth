<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="after_landing.Master.cs" Inherits="GrowWealth.after_landing" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Grow Wealth</title>
    <link href="~/Assets/css/style.css" rel="stylesheet" runat="server" type="text/css" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body style="min-height: 100vh; margin: 0; display: flex; flex-direction: column;">
    <form runat="server" id="form1" style="flex: 1; display: flex; flex-direction: column;">

        <!-- Top Navbar for Logged In User -->
        <header class="topbar">
            <a href="~/Default.aspx" runat="server" class="navbar-brand">Grow Wealth</a>

            <div class="navbar-actions">
                <span style="margin-right: 1rem; color: var(--text-secondary); font-weight: 500;">
                    <asp:Literal ID="litUserName" runat="server"></asp:Literal>
                </span>
                <asp:LoginStatus ID="lsLogout" runat="server" LogoutAction="Redirect" LogoutText="Logout"
                    LogoutPageUrl="~/Default.aspx" CssClass="btn btn-outline" />
            </div>
        </header>

        <!-- Sidebar Layout -->
        <div class="dashboard-wrapper">

            <!-- Left Sidebar -->
            <aside class="sidebar">
                <ul class="sidebar-nav">
                    <li>
                        <asp:HyperLink ID="lnkDashboard" runat="server"
                            NavigateUrl="~/Pages/Member/Dashboard.aspx">Dashboard</asp:HyperLink>
                    </li>
                    <li>
                        <asp:HyperLink ID="lnkCourses" runat="server"
                            NavigateUrl="~/Pages/Member/CoursePage.aspx">Courses</asp:HyperLink>
                    </li>
                    <li>
                        <asp:HyperLink ID="lnkVirtualLab" runat="server"
                            NavigateUrl="~/Pages/Member/VirtualLab.aspx">Virtual Lab</asp:HyperLink>
                    </li>
                    <li>
                        <asp:HyperLink ID="lnkProfile" runat="server"
                            NavigateUrl="~/Pages/Member/Profile.aspx">Profile</asp:HyperLink>
                    </li>
                </ul>

                <asp:Panel ID="pnlAdminLinks" runat="server" Visible="false">
                    <ul class="sidebar-nav" style="margin-top: 1rem; border-top: 1px solid var(--border); padding-top: 1rem;">
                        <li><a href="~/Pages/Admin/AdminDashboard.aspx" runat="server">Admin Panel</a></li>
                        <li><a href="~/Pages/Admin/ManageCourse.aspx" runat="server">Manage Courses</a></li>
                        <li><a href="~/Pages/Admin/ManageUser.aspx" runat="server">Manage Users</a></li>
                        <li><a href="~/Pages/Admin/ManageQuiz.aspx" runat="server">Manage Quiz</a></li>
                    </ul>
                </asp:Panel>
            </aside>

            <!-- Main Content Area -->
            <main class="dashboard-content">
                <asp:ContentPlaceHolder ID="MainContent" runat="server">
                </asp:ContentPlaceHolder>
            </main>
        </div>
    </form>
</body>
</html>
