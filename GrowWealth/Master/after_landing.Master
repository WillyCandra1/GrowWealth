<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="after_landing.Master.cs" Inherits="GrowWealth.Master.after_landing" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> &middot; Grow Wealth</title>
    <link href="~/Assets/css/style.css" rel="stylesheet" runat="server" type="text/css" />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        :root {
            --gw-ink: #0f1a14;
            --gw-ink-soft: #3d4a42;
            --gw-ink-muted: #6b766f;
            --gw-paper: #faf8f3;
            --gw-paper-warm: #f3efe6;
            --gw-surface: #ffffff;
            --gw-line: #e5e1d6;
            --gw-line-soft: #efeae0;
            --gw-accent: #0b6b3a;
            --gw-accent-dark: #094f2b;
            --gw-accent-soft: #e8f1ec;
            --gw-gold: #b8842c;
            --gw-gold-soft: #f5ebd6;
            --gw-rose: #a8443a;
            --gw-rose-soft: #f5e4e1;
            --gw-serif: 'Fraunces', 'Times New Roman', serif;
            --gw-sans: 'Inter', system-ui, sans-serif;
        }

        .gw-shell {
            background-color: var(--gw-paper);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            font-family: var(--gw-sans);
            color: var(--gw-ink);
            font-size: 15px;
            line-height: 1.6;
        }

        .gw-shell *,
        .gw-shell *::before,
        .gw-shell *::after {
            box-sizing: border-box;
        }

        .gw-shell h1, .gw-shell h2, .gw-shell h3, .gw-shell h4 {
            font-family: var(--gw-serif);
            color: var(--gw-ink);
            font-weight: 600;
            letter-spacing: -0.01em;
            line-height: 1.2;
        }

        .gw-shell a {
            text-decoration: none;
            color: var(--gw-accent);
            transition: color 0.18s;
        }

        .gw-shell a:hover {
            color: var(--gw-accent-dark);
        }

        .gw-topbar {
            background-color: var(--gw-surface);
            border-bottom: 1px solid var(--gw-line);
            padding: 0.9rem 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 50;
        }

        .gw-brand {
            font-family: var(--gw-serif);
            font-size: 1.35rem;
            font-weight: 700;
            color: var(--gw-ink);
            letter-spacing: -0.02em;
        }

        .gw-brand:hover { color: var(--gw-ink); }

        .gw-brand-dot {
            color: var(--gw-accent);
            margin-left: 2px;
        }

        .gw-topbar-right {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .gw-user-chip {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            color: var(--gw-ink-soft);
            font-size: 0.92rem;
            font-weight: 500;
        }

        .gw-user-chip-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--gw-accent) 0%, var(--gw-accent-dark) 100%);
            color: white;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.78rem;
            font-weight: 600;
            font-family: var(--gw-serif);
            overflow: hidden;
        }

        .gw-user-chip-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .gw-logout-btn {
            padding: 0.5rem 1rem;
            border: 1px solid var(--gw-line);
            border-radius: 6px;
            background-color: var(--gw-surface);
            color: var(--gw-ink);
            font-family: var(--gw-sans);
            font-size: 0.88rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.18s;
        }

        .gw-logout-btn:hover {
            border-color: var(--gw-ink);
            color: var(--gw-ink);
        }

        .gw-body {
            flex: 1;
            display: flex;
        }

        .gw-sidebar {
            width: 240px;
            background-color: var(--gw-surface);
            border-right: 1px solid var(--gw-line);
            padding: 1.75rem 0;
            flex-shrink: 0;
        }

        .gw-sidebar-section {
            padding: 0 1rem;
            margin-bottom: 1.75rem;
        }

        .gw-sidebar-label {
            font-size: 0.7rem;
            font-weight: 600;
            color: var(--gw-ink-muted);
            text-transform: uppercase;
            letter-spacing: 0.14em;
            padding: 0 0.85rem;
            margin-bottom: 0.6rem;
            display: block;
        }

        .gw-sidebar-nav {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .gw-sidebar-nav li { margin: 0; }

        .gw-sidebar-nav li a {
            display: flex;
            align-items: center;
            gap: 0.7rem;
            padding: 0.6rem 0.85rem;
            margin-bottom: 0.15rem;
            border-radius: 6px;
            color: var(--gw-ink-soft);
            font-size: 0.92rem;
            font-weight: 500;
            transition: all 0.15s;
        }

        .gw-sidebar-nav li a:hover {
            background-color: var(--gw-paper-warm);
            color: var(--gw-ink);
        }

        .gw-sidebar-nav li a.active {
            background-color: var(--gw-ink);
            color: var(--gw-paper);
        }

        .gw-sidebar-nav li a.active:hover {
            background-color: var(--gw-ink);
            color: var(--gw-paper);
        }

        .gw-sidebar-icon {
            width: 18px;
            height: 18px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            opacity: 0.8;
        }

        .gw-main {
            flex: 1;
            padding: 2.25rem 2.5rem 3rem;
            background-color: var(--gw-paper);
            overflow-x: hidden;
        }

        @media (max-width: 900px) {
            .gw-body { flex-direction: column; }
            .gw-sidebar {
                width: 100%;
                border-right: none;
                border-bottom: 1px solid var(--gw-line);
                padding: 1rem 0;
            }
            .gw-main { padding: 1.5rem 1.25rem 2rem; }
        }
    </style>
    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form runat="server" id="form1" class="gw-shell">

        <header class="gw-topbar">
            <a href="~/Default.aspx" runat="server" class="gw-brand">Grow Wealth<span class="gw-brand-dot">.</span></a>

            <div class="gw-topbar-right">
                <div class="gw-user-chip">
                    <span class="gw-user-chip-avatar">
                        <asp:Image ID="imgAvatar" runat="server" Visible="false" />
                        <asp:Literal ID="litAvatarInitials" runat="server"></asp:Literal>
                    </span>
                    <asp:Literal ID="litUserName" runat="server"></asp:Literal>
                </div>
                <asp:LinkButton ID="btnLogout" runat="server" OnClick="btnLogout_Click" CssClass="gw-logout-btn" CausesValidation="false">Log out</asp:LinkButton>
            </div>
        </header>

        <div class="gw-body">

            <aside class="gw-sidebar">
                <div class="gw-sidebar-section">
                    <span class="gw-sidebar-label">Learn</span>
                    <ul class="gw-sidebar-nav">
                        <li>
                            <asp:HyperLink ID="lnkDashboard" runat="server" NavigateUrl="~/Pages/Member/Dashboard.aspx">
                                <span class="gw-sidebar-icon">&#9632;</span>Dashboard
                            </asp:HyperLink>
                        </li>
                        <li>
                            <asp:HyperLink ID="lnkCourses" runat="server" NavigateUrl="~/Pages/Member/CoursePage.aspx">
                                <span class="gw-sidebar-icon">&#9633;</span>Courses
                            </asp:HyperLink>
                        </li>
                        <li>
                            <asp:HyperLink ID="lnkVirtualLab" runat="server" NavigateUrl="~/Pages/Member/VirtualLab.aspx">
                                <span class="gw-sidebar-icon">&#8943;</span>Virtual Lab
                            </asp:HyperLink>
                        </li>
                    </ul>
                </div>

                <div class="gw-sidebar-section">
                    <span class="gw-sidebar-label">Account</span>
                    <ul class="gw-sidebar-nav">
                        <li>
                            <asp:HyperLink ID="lnkProfile" runat="server" NavigateUrl="~/Pages/Member/Profile.aspx">
                                <span class="gw-sidebar-icon">&#9675;</span>Profile
                            </asp:HyperLink>
                        </li>
                    </ul>
                </div>

                <asp:Panel ID="pnlAdminLinks" runat="server" Visible="false">
                    <div class="gw-sidebar-section">
                        <span class="gw-sidebar-label">Admin</span>
                        <ul class="gw-sidebar-nav">
                            <li><a href="~/Pages/Admin/AdminDashboard.aspx" runat="server"><span class="gw-sidebar-icon">&#9650;</span>Admin Panel</a></li>
                            <li><a href="~/Pages/Admin/ManageCourse.aspx" runat="server"><span class="gw-sidebar-icon">&#9650;</span>Manage Courses</a></li>
                            <li><a href="~/Pages/Admin/ManageUser.aspx" runat="server"><span class="gw-sidebar-icon">&#9650;</span>Manage Users</a></li>
                            <li><a href="~/Pages/Admin/ManageQuiz.aspx" runat="server"><span class="gw-sidebar-icon">&#9650;</span>Manage Quiz</a></li>
                        </ul>
                    </div>
                </asp:Panel>
            </aside>

            <main class="gw-main">
                <asp:ContentPlaceHolder ID="MainContent" runat="server">
                </asp:ContentPlaceHolder>
            </main>
        </div>

    </form>
</body>
</html>
